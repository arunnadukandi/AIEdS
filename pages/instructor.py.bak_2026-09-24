@st.cache_data(show_spinner=False)
def _bg_b64():
    for name in ["instructor_background.jpeg", "instructor_background.png",
                 "instructor_background.jpg", "mainpage.jpeg"]:
        p = os.path.join(BASE_DIR, name)
        if os.path.exists(p):
