        def _file_to_image_b64(fname, data):
            """Best-effort: render a submitted file as one PNG for the vision
            model. Images pass straight through; a PDF's first page is rasterised
            with the same PyMuPDF handle used for textbook indexing above. Any
            other file type (docx/zip/txt) can't be graded by AI directly — the
            caller falls back to manual scoring for those."""
            ext = (fname or "").lower().rsplit(".", 1)[-1] if fname and "." in fname else ""
            if ext in ("png", "jpg", "jpeg"):
                return base64.b64encode(data).decode("utf-8")
            if ext == "pdf":
                try:
                    _doc = fitz.open(stream=data, filetype="pdf")
                    _pix = _doc[0].get_pixmap(dpi=150)
                    return base64.b64encode(_pix.tobytes("png")).decode("utf-8")
                except Exception:
                    return None
            return None

        def _build_grading_prompt(model_name, title, subject, marks, cadet_label, key_present, notes):
            notes_ctx = f"\nAdditional notes: {notes}" if notes and notes.strip() else ""
            cadet_ctx = f"Cadet: {cadet_label}" if cadet_label else ""
            if "moondream" in model_name:
                return (
                    f"Look at this image of a cadet answer sheet.\n"
                    f"Assignment: {title}. Subject: {subject}. {cadet_ctx}\n"
                    f"1. What has the cadet written? Describe in detail.\n"
                    f"2. Is the answer correct and complete?\n"
                    f"3. Give a SCORE out of {marks}.\n"
                    f"4. Strengths and weaknesses?{notes_ctx}"
                )
            key_ctx = "\nANSWER KEY: [See second image provided]" if key_present else ""
            return (
                f"You are an experienced naval academy instructor.\n"
                f"Assignment: {title}. Subject: {subject}. {cadet_ctx}\n"
                f"Total marks: {marks}.{key_ctx}{notes_ctx}\n\n"
                f"CADET ANSWER: [See image provided]\n\n"
                f"Provide:\n"
                f"- SCORE: X / {marks}\n"
                f"- STRENGTHS: What was answered correctly\n"
                f"- WEAKNESSES: What was missing or incorrect\n"
                f"- SUGGESTIONS: Specific advice\n"
                f"- OVERALL REMARKS: 2-3 sentence summary"
            )

        def _run_ai_grading(model_name, cadet_img_b64, key_img_b64, title, subject, marks, cadet_label, notes):
            prompt_text = _build_grading_prompt(model_name, title, subject, marks, cadet_label,
                                                bool(key_img_b64), notes)
            images = [cadet_img_b64]
            if key_img_b64 and "moondream" not in model_name:
                images.append(key_img_b64)
            from ollama import Client
            from httpx import Timeout
            client = Client(host="http://127.0.0.1:11434", timeout=Timeout(120.0))
            resp = client.chat(
                model=model_name,
                messages=[{"role":"user","content":prompt_text,"images":images}],
                stream=False, keep_alive=-1,
                options={"num_gpu": 50, "temperature": 0.1,
                         "num_ctx": 512 if "moondream" in model_name else 4096}
            )
            eval_result = (resp["message"]["content"] if isinstance(resp, dict)
                           else resp.message.content).strip()
            # Match: 15/20 or 15 / 20 or 15 out of 20 or SCORE: 15
            score_m = (
                re.search(r'(\d+(?:\.\d+)?)\s*/\s*' + str(marks), eval_result) or
                re.search(r'(\d+(?:\.\d+)?)\s+out\s+of\s+' + str(marks), eval_result, re.IGNORECASE) or
                re.search(r'SCORE[:\s]+(\d+(?:\.\d+)?)', eval_result, re.IGNORECASE)
            )
            score_val = None
            if score_m:
                try: score_val = float(score_m.group(1))
                except (TypeError, ValueError): pass
            return eval_result, score_val

