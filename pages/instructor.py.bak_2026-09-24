        VISION_MODELS = ["moondream","llava","llava-llama3","bakllava",
                         "minicpm-v","llama3.2-vision","gemma3"]
        def _detect_vm():
            try:
                from ollama import Client
                from httpx import Timeout
                cl = Client(host="http://127.0.0.1:11434", timeout=Timeout(10.0))
                ml = cl.list()
                names = [getattr(m,"model",None) or m.get("model","")
                         for m in (ml.models if hasattr(ml,"models") else ml.get("models",[]))]
                for n in names:
                    for vm in VISION_MODELS:
