            # for scanned pages, and the same {stem}_faiss.index / _doc.json /
            # _meta.json files + static/images/<stem>/ illustrations as before.
            from pdf_ingest import build_index, tesseract_available

            def process_pdf_advanced(pdf_file, subject_name, term_folder_name, model):
                safe_subject = subject_name.strip().replace(" ", "_").lower()
                manual_name  = os.path.splitext(pdf_file.name)[0]
                safe_manual  = manual_name.strip().replace(" ", "_").lower()
                file_stem    = f"{safe_subject}_{safe_manual}" if safe_manual != safe_subject else safe_subject
                term_dir     = os.path.join(BASE_DIR, "user_profiles", term_folder_name)
                IMAGE_DIR    = os.path.join(BASE_DIR, "static", "images", file_stem)
                os.makedirs(term_dir, exist_ok=True)
                os.makedirs(IMAGE_DIR, exist_ok=True)

                # Save original PDF to term folder first (study_materials.py lists it,
                # and it is the file we index from).
                pdf_dest = os.path.join(term_dir, pdf_file.name)
                with open(pdf_dest, "wb") as f:
                    f.write(pdf_file.getbuffer())

                progress_bar = st.progress(0, text="Reading pages")
                def _progress(frac, msg):
                    progress_bar.progress(frac, text=msg)

                n_chunks, stats = build_index(
                    pdf_dest, subject_name, manual_name, term_dir, file_stem, model,
                    progress_cb=_progress,
                    image_dir=IMAGE_DIR,
                    image_web_prefix=f"/app/static/images/{file_stem}",
                )
                return n_chunks, file_stem, stats

            if not tesseract_available():
                st.warning("Tesseract OCR not found on this server — scanned pages cannot be read. "
                           "Text-based PDFs will still index normally.")
            embedder = load_embedder_model()
            try:
                count, stem, stats = process_pdf_advanced(up_file, sub_name, term_selection, embedder)
                st.success(f"✅  Successfully indexed **{count}** context chunks for **'{sub_name}'** → Term {term_selection}.")
                st.caption(f"{stats['pages']} pages · {stats['ocr_pages']} read with OCR · "
                           f"{stats['empty_pages']} without readable text · {stats['seconds']}s")
            except ValueError as e:
                st.error(str(e))
            except Exception as e:
                st.error(f"Indexing failed: {e}")
        else:
            st.error("Please provide both a Subject Name and a PDF file.")


