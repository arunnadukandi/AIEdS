# ============================================================
#  AIEdS — LLM Provider Configuration
#  Copy this file to  login/.env  and fill in your values.
#  The .env file is NEVER committed to git.
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
# Choose ONE provider. Comment/uncomment to switch.
#
#   groq   → FREE, no credit card needed. Get key at console.groq.com
#   claude → Paid (very cheap ~$0.001/chat). Get key at console.anthropic.com
#   ollama → Local Ollama server on your workstation (no internet needed)
#
LLM_PROVIDER=groq


# ── Groq Settings (FREE tier — recommended for laptop testing) ──
# Sign up free at: https://console.groq.com → API Keys → Create key
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY_HERE

# Best free models on Groq (pick one):
#   llama-3.1-8b-instant    ← fastest, great for Q&A  (default)
#   llama-3.3-70b-versatile ← smarter, slightly slower
#   mixtral-8x7b-32768      ← good for longer context
GROQ_MODEL=llama-3.1-8b-instant


# ── Claude / Anthropic Settings (paid, optional) ────────────
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_CLAUDE_KEY_HERE
CLAUDE_MODEL=claude-3-5-haiku-20241022
CLAUDE_VISION_MODEL=claude-3-5-sonnet-20241022


# ── Ollama Settings (local workstation only) ─────────────────
# Only needed when LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_VISION_MODEL=llava:7b
